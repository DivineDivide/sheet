# The chat's key, from https://platform.claude.com → API keys. In production it is a
# secret instead: `npx wrangler secret put ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# The cursors' Realtime app, from the Cloudflare dashboard → Realtime. In production these
# are secrets too: `npx wrangler secret put CF_REALTIME_ID`, and the same for the key.
CF_REALTIME_ID=
CF_REALTIME_KEY=
